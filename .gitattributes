# Keep exact publication bytes so SHA256 manifests and retained-input hashes
# remain valid across Windows and Unix checkouts.
* -text whitespace=cr-at-eol
# Preserve generated SVG paths and archived source/config bytes verbatim.
*.svg -whitespace
result/retained-mil-inputs/** -whitespace
# Exact archived runtime bytes are part of the nested protocol hash contract.
protocol/qaclf_nested_v1/** -whitespace
